<resources>
    <!--
        One dark platform theme, because the app is dark-surfaced in every
        palette. It colours everything the app does not draw itself: dialogs,
        spinner dropdowns, EditText carets and selection handles, and the
        window background shown before the first frame.

        There is deliberately no light variant. A single Light theme used to
        be applied to all palettes, which put near-black platform text on dark
        surfaces; the palettes now differ only by accent, so one dark theme is
        correct for all of them and cannot drift out of step again.

        Status and navigation bar colours are set at runtime from the active
        palette (UiKit.applyWindowChrome), since they follow its gradient.
    -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/accent_default</item>
        <item name="android:colorBackground">@color/surface_background</item>
        <item name="android:windowBackground">@color/surface_background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>
